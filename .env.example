# Copy to .env for local development. Never commit real credentials.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-local-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://omid:omid_dev_only@localhost:5432/omid
LOGIN_RATE_LIMIT=5/minute
LOGIN_IP_RATE_LIMIT=20/minute
PASSWORD_CHANGE_RATE_LIMIT=5/hour
